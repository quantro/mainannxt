# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db

# secrets, keys & certificates
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
*.keystore
*.jks
credential*.json
service-account*.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.enx
.env*.local

# package manager (may contain auth tokens)
.npmrc
.yarnrc.yml

# vercel
.vercel

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-workspace

# test artifacts
/coverage
/playwright-report/
/test-results/
/cypress/videos/
/cypress/screenshots/

# typescript
*.tsbuildinfo
next-env.d.ts

# server data
.data/

# project docs
AGENTS.md
CLAUDE.md
DESIGN.md
